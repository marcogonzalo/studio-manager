{
  "name": "interior-design-project",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "db:push": "supabase db push --local",
    "db:reset": "supabase db reset --local",
    "seed:demo": "node scripts/run-seed-demo-local.mjs",
    "seed:base-limits": "node scripts/run-seed-base-limits-local.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lighthouse": "lighthouse http://localhost:3000 --view",
    "perf:install-browsers": "node node_modules/playwright-core/cli.js install chromium",
    "perf:audit": "tsx scripts/performance-audit.mts",
    "perf:audit:desktop": "PERF_VIEWPORT=desktop tsx scripts/performance-audit.mts",
    "perf:audit:throttle": "PERF_THROTTLE=1 tsx scripts/performance-audit.mts",
    "analyze": "ANALYZE=true pnpm run build",
    "docker:dev": "docker compose up",
    "docker:dev:build": "docker compose up --build",
    "docker:test": "docker compose --profile test run --rm test",
    "docker:prod": "docker compose --profile prod up --build app-prod",
    "docker:lint": "docker compose exec app pnpm run lint",
    "docker:build-check": "docker compose exec app pnpm run build",
    "supabase:start": "node scripts/supabase-local.mjs slim",
    "supabase:start:full": "node scripts/supabase-local.mjs start",
    "supabase:studio": "node scripts/supabase-local.mjs studio",
    "supabase:mail": "node scripts/supabase-local.mjs mail",
    "supabase:status": "supabase status",
    "supabase:stop": "supabase stop"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@next/third-parties": "^16.4.3",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.43.0",
    "gray-matter": "^4.0.3",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.577.0",
    "mailersend": "^2.8.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-phone-number-input": "^3.4.18",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@next/bundle-analyzer": "^16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "browserslist": [
    "chrome >= 120",
    "edge >= 120",
    "firefox >= 121",
    "safari >= 17.3",
    "opera >= 106"
  ]
}
